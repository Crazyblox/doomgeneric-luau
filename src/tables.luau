--!native
--!optimize 2
local doomtype = require("./doomtype")
local tables = {}

local FINEANGLES = doomtype.FINEANGLES
local FRACUNIT = doomtype.FRACUNIT
local SLOPERANGE = doomtype.SLOPERANGE

local PI = 3.14159265358979323846

-- Round a double to float32 (round-to-nearest-even, matching C float casts).
local function f32(x)
    return string.unpack("f", string.pack("f", x))
end

-- C truncation toward zero.
local function trunc(x)
    if x >= 0 then
        return math.floor(x)
    end
    return -math.floor(-x)
end

-- ---------------------------------------------------------------------------
-- finetangent[4096]
-- ---------------------------------------------------------------------------

local finetangent = {}
do
    local twopi_over_fine = PI * 2 / FINEANGLES
    for i = 0, 4095 do
        local a = f32((i - FINEANGLES / 4 + 0.5) * twopi_over_fine)
        finetangent[i + 1] = trunc(f32(FRACUNIT * math.tan(a)))
    end
end
tables.finetangent = finetangent

-- ---------------------------------------------------------------------------
-- finesine[10240]  (finecosine = &finesine[FINEANGLES/4])
-- ---------------------------------------------------------------------------

local finesine = {}
do
    local twopi_over_fine = PI * 2 / FINEANGLES
    for i = 0, 5 * FINEANGLES / 4 - 1 do
        local a = f32((i + 0.5) * twopi_over_fine)
        finesine[i + 1] = trunc(f32(FRACUNIT * math.sin(a)))
    end
end
tables.finesine = finesine
tables.finecosine = finesine  -- index offset handled by callers (+ FINEANGLES/4)

-- ---------------------------------------------------------------------------
-- tantoangle[2049]
-- ---------------------------------------------------------------------------

local tantoangle = {}
do
    local pi2 = 3.141592657 * 2
    for i = 0, SLOPERANGE - 1 do
        local f = f32(math.atan(i / SLOPERANGE) / pi2)
        tantoangle[i + 1] = trunc(0xffffffff * f)
    end
    -- The +1 size handles the case when x == y without additional checking.
    tantoangle[SLOPERANGE + 1] = 0x20000000 -- ANG45
end
tables.tantoangle = tantoangle

