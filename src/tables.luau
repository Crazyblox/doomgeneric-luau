-- ---------------------------------------------------------------------------
-- SlopeDiv
--
-- C: unsigned int SlopeDiv(unsigned int num, unsigned int den)
--       if (den < 512) return SLOPERANGE;
--       ans = (num << 3) / (den >> 8);
--       if (ans <= SLOPERANGE) return ans;
--       return SLOPERANGE;
--
-- num/den are passed as signed ints by callers but treated as unsigned here
-- (the classic Doom quirk), so negative values become huge unsigned.
-- ---------------------------------------------------------------------------

function tables.SlopeDiv(num, den)
    num = num % 0x100000000
    den = den % 0x100000000

    if den < 512 then
        return SLOPERANGE
    end

    local ans = doomtype.truncdiv(bit32.lshift(num, 3), bit32.rshift(den, 8))

    if ans <= SLOPERANGE then
        return ans
    end
    return SLOPERANGE
end

return tables